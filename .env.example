# ===== App =====
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# Set true only when running behind a reverse proxy (Nginx, Render, Railway, etc.)
TRUST_PROXY=false
# true = the API process also runs the BullMQ workers (simplest for local dev)
RUN_WORKERS_IN_SERVER=true
# Your frontend's URL. Used for CORS, cookies, and links in emails
FRONTEND_URL=http://localhost:5173

# ===== Databases =====
# Local MongoDB. For Atlas use: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nearby-chat
MONGODB_URI=mongodb://127.0.0.1:27017/nearby-chat
REDIS_URL=redis://127.0.0.1:6379

# ===== Auth (generate your own secrets, see instructions) =====
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
# Leave empty for localhost. In production set your domain, e.g. .example.com
COOKIE_DOMAIN=
JWT_ACCESS_EXPIRES_IN_MINUTES=15
JWT_REFRESH_EXPIRES_IN_DAYS=7
EMAIL_VERIFICATION_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_MINUTES=30

# ===== Cloudinary (private media storage) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Email (verification + password reset) =====
# Optional in development: if empty, emails are printed to the console instead
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Nearby Chat <no-reply@nearbychat.local>

# ===== Feature rules =====
MESSAGE_EXPIRY_MINUTES=30
# Hard limit is 10 MB
MAX_FILE_SIZE_MB=10
# Hard limit is 5 km
NEARBY_MAX_RADIUS_KM=5
# How long a stored location is kept before cleanup deletes it
LOCATION_RETENTION_MINUTES=15
SIGNED_URL_EXPIRY_SECONDS=300

# ===== Rate limiting =====
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ===== First admin account (used by the seed script later) =====
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=